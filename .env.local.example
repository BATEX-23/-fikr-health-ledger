# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). Restart `npm run dev` after changing it.
#
# Leave `.env.local` missing/empty to run in local-only mode (localStorage,
# no cross-device sync).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
